/* Educational selection; five examples are not an exhaustive count of Sunnah. */
(()=>{
const parent=render;
const ref=(url,label)=>`<a class="ref-link" href="${url}" target="_blank" rel="noopener noreferrer">${label} ↗</a>`;
const examples=[
['Istighfar ringkas','أَسْتَغْفِرُ اللَّهَ','Aku memohon keampunan Allah.','Baginda beristighfar tiga kali selepas solat. Lafaz ini diterangkan oleh al-Awza‘i dalam riwayat tersebut.','https://sunnah.com/muslim:591','Sahih Muslim 591',false],
['Sayyidul Istighfar','اللَّهُمَّ أَنْتَ رَبِّي','Ya Allah, Engkau adalah Rabbku,','Doa yang baginda ajarkan sebagai penghulu istighfar. Hadis menyebut kelebihan membacanya dengan penuh keyakinan pada siang atau malam.','https://sunnah.com/bukhari:6306','Sahih al-Bukhari 6306',true],
['Istighfar ketika rukuk dan sujud','سُبْحَانَكَ اللَّهُمَّ رَبَّنَا وَبِحَمْدِكَ، اللَّهُمَّ اغْفِرْ لِي','Maha Suci Engkau, ya Allah Tuhan kami, dan segala puji bagi-Mu. Ya Allah, ampunilah aku.','Baginda banyak membacanya ketika rukuk dan sujud.','https://sunnah.com/bukhari:817','Sahih al-Bukhari 817',false],
['Memohon keampunan semua dosa ketika sujud','اللَّهُمَّ اغْفِرْ لِي ذَنْبِي كُلَّهُ، دِقَّهُ وَجِلَّهُ، وَأَوَّلَهُ وَآخِرَهُ، وَعَلَانِيَتَهُ وَسِرَّهُ','Ya Allah, ampunilah semua dosaku: yang kecil dan besar, yang terdahulu dan terkemudian, yang terang dan tersembunyi.','Baginda membacanya ketika sujud.','https://sunnah.com/muslim:483','Sahih Muslim 483',false],
['Doa keampunan yang menyeluruh','رَبِّ اغْفِرْ لِي خَطِيئَتِي وَجَهْلِي','Wahai Tuhanku, ampunilah kesalahanku dan kejahilanku.','Doa panjang baginda memohon keampunan atas kesalahan, kejahilan, keterlaluan serta perkara yang tersembunyi dan nyata. Buka hadis untuk lafaz penuh.','https://sunnah.com/bukhari:6398','Sahih al-Bukhari 6398',true]
];
function view(){return `<header class="top"><div><div class="brand">AKSI</div><div class="tiny">${kid()?'Kanak-kanak · Belajar bersama ibu bapa atau guru':'Dewasa · Kenali sunnah'}</div></div><button class="pill" onclick="go('home')">⌂ Menu</button></header><div class="ey">KENALI AMALAN RASULULLAH SAW</div><h1>Istighfar dalam Sunnah Rasulullah SAW</h1><p class="sub">${kid()?'Jom kenali cara Rasulullah SAW memohon keampunan Allah.':'Kenali kekerapan istighfar, contoh lafaz serta dalil al-Quran dan hadis sahih.'}</p><section class="card sage"><h2>Bilangan istighfar dalam amalan baginda</h2><div class="stack"><p class="sub"><b>Lebih daripada 70 kali sehari</b><br>Baginda menyatakan bahawa baginda memohon keampunan dan bertaubat lebih daripada 70 kali sehari.</p>${ref('https://sunnah.com/bukhari:6307','Sahih al-Bukhari 6307')}<p class="sub"><b>100 kali sehari — riwayat lain</b><br>Baginda menyatakan bahawa baginda beristighfar 100 kali sehari.</p>${ref('https://sunnah.com/muslim:2702a','Sahih Muslim 2702a')}<p class="sub"><b>Tiga kali selepas selesai solat</b><br>Baginda beristighfar tiga kali, kemudian membaca doa “Allahumma antas-salam…”.</p>${ref('https://sunnah.com/muslim:591','Sahih Muslim 591')}</div><p class="tiny">Angka ini menerangkan kekerapan bacaan, bukan jumlah jenis lafaz istighfar.</p></section><h2>Antara bentuk istighfar yang sahih</h2><p class="sub">Lima contoh berikut merangkumi amalan baginda dan lafaz yang baginda ajarkan. Ini pilihan untuk pembelajaran, bukan senarai keseluruhan sunnah.</p>${examples.map((e,i)=>`<section class="card"><span class="badge">Contoh ${i+1} daripada 5</span><h2>${e[0]}</h2>${e[6]?'<p class="tiny"><b>Petikan permulaan doa sahaja</b></p>':''}<div class="ar" lang="ar">${e[1]}</div><p class="meaning">${e[2]}</p><p class="tiny">${e[6]?'Makna petikan permulaan.':'Terjemahan makna untuk penerangan.'}</p><p class="sub">${e[3]}</p>${ref(e[4],e[5])}${i===1?button('Baca Sayyidul Istighfar Lengkap',"go('full')",'alt'):''}</section>`).join('')}<section class="card"><h2>Asas daripada al-Quran</h2><p class="sub"><b>Surah an-Nasr 110:3</b><br>Allah memerintahkan Nabi SAW supaya bertasbih dengan memuji Tuhan dan memohon keampunan-Nya. Sayidatina Aisyah RA mengaitkan amalan rukuk dan sujud dalam Contoh 3 dengan pelaksanaan perintah al-Quran.</p>${ref('https://quran.com/110/3','Baca an-Nasr 110:3')}${ref('https://sunnah.com/bukhari:817','Hadis amalan rukuk dan sujud')}<p class="sub"><b>Surah Muhammad 47:19</b><br>Allah memerintahkan Nabi SAW memohon keampunan bagi dirinya serta orang beriman lelaki dan perempuan.</p>${ref('https://quran.com/47/19','Baca Muhammad 47:19')}<p class="tiny">Ringkasan maksud ayat untuk pembelajaran.</p></section><div class="buttons">${button('Kepentingan dan Kelebihan',"go('merits')")}${button('Sumber Rujukan',"go('sources')",'alt')}${button('Menu Utama',"go('home')",'alt')}</div><footer class="foot">AKSI · Istighfar dalam Sunnah · Prototaip 16</footer>`}
render=function(){if(route==='sunnah'){window.askStopAudio?.();const app=document.getElementById('app');app.className='app '+(kid()?'kid':'');app.innerHTML='<div class="screen">'+view()+'</div>';window.askMountAudio?.();return}parent();if(route==='home'){const anchor=[...document.querySelectorAll('#app .menu button')].find(b=>b.getAttribute('onclick')==="go('reflect')");if(anchor){const holder=document.createElement('div');holder.innerHTML=navItem('Istighfar dalam Sunnah Rasulullah SAW','Kekerapan, lafaz dan dalil sahih',"go('sunnah')");anchor.insertAdjacentElement('afterend',holder.firstElementChild)}}};render();
})();

