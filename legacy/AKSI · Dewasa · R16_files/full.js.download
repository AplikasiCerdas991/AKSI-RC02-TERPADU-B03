'use strict';
const sections=[
['اللَّهُمَّ أَنْتَ رَبِّي','Ya Allah, Engkau adalah Rabbku,',[['اللَّهُمَّ','Ya Allah'],['أَنْتَ','Engkau'],['رَبِّي','Rabbku']]],
['لَا إِلَهَ إِلَّا أَنْتَ','tidak ada Tuhan yang berhak disembah dengan benar melainkan Engkau.',[['لَا إِلَهَ','Tidak ada Tuhan yang berhak disembah dengan benar'],['إِلَّا','Melainkan'],['أَنْتَ','Engkau']]],
['خَلَقْتَنِي وَأَنَا عَبْدُكَ','Engkau yang menciptakan aku dan aku adalah hambaMu.',[['خَلَقْتَنِي','Engkau yang menciptakan aku'],['وَأَنَا','Dan aku'],['عَبْدُكَ','HambaMu']]],
['وَأَنَا عَلَى عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ','Aku di atas perjanjianMu dan janjiMu sesuai dengan kemampuanku.',[['وَأَنَا','Dan aku'],['عَلَى','Di atas'],['عَهْدِكَ','PerjanjianMu'],['وَوَعْدِكَ','Dan janjiMu'],['مَا اسْتَطَعْتُ','Sesuai dengan kemampuanku']]],
['أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ','Aku berlindung kepadaMu dari keburukan perbuatanku,',[['أَعُوذُ','Aku berlindung'],['بِكَ','KepadaMu'],['مِنْ','Dari'],['شَرِّ','Keburukan'],['مَا صَنَعْتُ','Perbuatanku']]],
['أَبُوءُ لَكَ بِنِعْمَتِكَ عَلَيَّ','aku mengakui nikmatMu kepadaku',[['أَبُوءُ لَكَ','Aku mengakui kepadaMu'],['بِنِعْمَتِكَ','NikmatMu'],['عَلَيَّ','Kepadaku']]],
['وَأَبُوءُ لَكَ بِذَنْبِي','dan aku mengakui dosaku kepadaMu,',[['وَأَبُوءُ لَكَ','Dan aku mengakui kepadaMu'],['بِذَنْبِي','Dosaku']]],
['فَاغْفِرْ لِي','maka ampunilah aku.',[['فَاغْفِرْ','Maka ampunilah'],['لِي','Bagiku — dalam frasa ini: aku']]],
['فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ','Ini kerana, tiada yang dapat mengampuni dosa melainkan Engkau.',[['فَإِنَّهُ','Ini kerana — mengikut ungkapan makna induk'],['لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ','Tiada yang dapat mengampuni dosa melainkan Engkau']]]
];
const notes={1:'“لَا إِلَهَ” dipelajari bersama sebagai satu unit makna.',3:'“مَا اسْتَطَعْتُ” dipelajari bersama. Makna frasa penuh dikekalkan mengikut makna induk.',4:'“مَا صَنَعْتُ” dipelajari bersama sebagai satu unit makna.',5:'Makna bantuan menerangkan kalimah dalam konteks; makna frasa yang diluluskan dikekalkan.',7:'“لِي” bermaksud “bagiku”; dalam frasa penuh, gunakan “maka ampunilah aku.”',8:'Bahagian ini dinilai melalui makna frasa penuh. “Ini kerana” ialah ungkapan dalam makna induk.'};
const key='ASK_ISTIGHFAR_FULL_R02',oldKey='ASK_ISTIGHFAR_B1_REVIEW01',DAY=86400000;
let db={mode:'adult',adult:{parts:{}},child:{parts:{}}},storageOK=true;
try{const raw=JSON.parse(localStorage.getItem(key));if(raw&&['adult','child'].includes(raw.mode)&&raw.adult?.parts&&raw.child?.parts)db=raw;else{const old=JSON.parse(localStorage.getItem(oldKey));if(old){for(const m of ['adult','child'])if(old[m])db[m].parts[0]={initial:old[m].initial||null,needs:(old[m].needs||[]).map(id=>({S01:'K0',S02:'K1',S03:'K2',S07:'F',S08:'O'}[id]||id)),practice:old[m].practice||[]};if(['adult','child'].includes(old.mode))db.mode=old.mode}}}catch(e){storageOK=false}
if(typeof window!=='undefined'&&['adult','child'].includes(window.AKSI_PROFILE))db.mode=window.AKSI_PROFILE;
let route='home',part=0,idx=0,reveal=false,quiz=[],qi=0,selected=null,checked=false,order=[],answers=[],kind='initial',finalAnswers=[],finalIndex=0,fullMode='paired';
const profile=()=>db[db.mode],pstate=(n=part)=>profile().parts[n]||(profile().parts[n]={}),kid=()=>db.mode==='child',t=(a,b)=>kid()?b:a;
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function save(){try{localStorage.setItem(key,JSON.stringify(db));storageOK=true}catch(e){storageOK=false}}
function button(label,action,cls=''){return `<button class="btn ${cls}" onclick="${action}">${label}</button>`}
function go(r){route=r;reveal=false;render();window.scrollTo(0,0)}
function mode(m){db.mode=m;save();go('home')}
function openPart(n,r='learn',i=0){part=n;idx=i;profile().resume={part,route:r,idx};save();go(r)}
function resume(){const r=profile().resume;if(r&&Number.isInteger(r.part)&&r.part>=0&&r.part<9)openPart(r.part,['learn','phrase','flash'].includes(r.route)?r.route:'learn',r.idx||0);else{const n=sections.findIndex((_,i)=>!pstate(i).initial);openPart(n<0?0:n)}}
function navItem(title,desc,action){return `<button class="btn alt" style="text-align:left" onclick="${action}">${title}<small style="display:block;font-weight:400;color:var(--muted);margin-top:4px">${desc}</small></button>`}
function home(){const done=sections.filter((_,i)=>pstate(i).initial).length;return `<div class="switch"><button class="${!kid()?'active':''}" aria-pressed="${!kid()}" onclick="mode('adult')">Dewasa</button><button class="${kid()?'active':''}" aria-pressed="${kid()}" onclick="mode('child')">Kanak-kanak</button></div><section class="hero"><span class="spark" aria-hidden="true">🌿</span><div class="ey">9 BAHAGIAN · SAYYIDUL ISTIGHFAR</div><h1>Penghulu<br>Isytighfar</h1><p class="sub">Fahami makna, ingati bacaan, hayati doa.</p><div class="ar" lang="ar">${sections[0][0]}</div>${button(profile().resume?'Sambung Belajar':t('Mula Belajar','Jom Belajar'),'resume()','gold')}</section><div class="ctx"><span>${done} / 9 bahagian telah disemak</span><span>${Math.round(done/9*100)}%</span></div><div class="progress"><i style="width:${done/9*100}%"></i></div><div class="menu">${navItem('Pilih Bahagian','Belajar atau ulang mana-mana bahagian',"go('parts')")}${navItem('Bacaan dan Makna','Doa lengkap dan makna induk',"go('full')")}${navItem('Kad Imbas','Pilih bahagian untuk mengingat semula',"go('flashParts')")}${navItem(t('Semak Kefahaman','Cuba Jawab'),'Semakan setiap bahagian dan doa lengkap',"go('assessParts')")}${navItem(t('Ulang Kaji Saya','Jom Ulang'),'Latihan semula dan semakan ingatan 24 jam',"go('review')")}${navItem('Hayati Doa','Renungan ringkas berdasarkan makna',"go('reflect')")}</div><p class="tiny">Kemajuan disimpan dalam pelayar dan peranti ini. Pilihan dewasa dan kanak-kanak mempunyai kemajuan berasingan.</p>`}
function partsView(){const r=route;return `<h2>${r==='flashParts'?'Pilih Kad Imbas':r==='assessParts'?'Pilih Semakan':'Pilih Bahagian'}</h2><div class="stack">${sections.map((s,n)=>navItem(`Bahagian ${n+1}${pstate(n).initial?' · Telah disemak':''}`,s[1],r==='assessParts'?`part=${n};startQuiz('initial')`:`openPart(${n},'${r==='flashParts'?'flash':'learn'}')`)).join('')}</div>${r==='assessParts'?button('Semak Doa Lengkap',"startFinal('module')") :''}`}
function learning(){const units=sections[part][2];idx=Math.min(idx,units.length-1);const w=units[idx];return `<div class="ctx"><span>Bahagian ${part+1} / 9</span><span>Kalimah / unit ${idx+1} / ${units.length}</span></div><h2>${t('Kenali kalimah','Jom kenali kalimah')}</h2><section class="card"><div class="ar" lang="ar">${w[0]}</div><p class="meaning">${w[1]}</p></section><p class="tiny">Makna bantuan kalimah / unit dalam konteks doa.</p>${notes[part]?`<div class="notice">${notes[part]}</div>`:''}<div class="buttons">${button(idx<units.length-1?'Seterusnya':'Gabungkan Frasa',idx<units.length-1?`openPart(${part},'learn',${idx+1})`:`openPart(${part},'phrase')`)}${idx?button('Sebelumnya',`openPart(${part},'learn',${idx-1})`,'alt'):''}${button('Rehat Dahulu',"go('home')",'alt')}</div>`}
function phraseView(){const s=sections[part];return `<div class="ey">BAHAGIAN ${part+1} · FRASA LENGKAP</div><h2>${t('Fahami frasa','Jom baca bersama')}</h2><section class="card"><div class="ar" lang="ar">${s[0]}</div><p class="meaning">${s[1]}</p></section><details><summary>Lihat pecahan kalimah</summary>${s[2].map(w=>`<p class="ar" lang="ar" style="font-size:30px">${w[0]}</p><p class="sub" style="text-align:center">${w[1]}</p>`).join('')}</details><div class="buttons">${button('Cuba Kad Imbas',`openPart(${part},'flash')`)}${button('Semak Kefahaman',"startQuiz('initial')",'alt')}</div>`}
function flashView(){const s=sections[part],cards=[...s[2],[s[0],s[1]]];idx=Math.min(idx,cards.length-1);const w=cards[idx];return `<div class="ctx"><span>Bahagian ${part+1}</span><span>Kad ${idx+1} / ${cards.length}</span></div><h2>${t('Cuba ingat maknanya','Apakah maknanya?')}</h2><p class="sub">Baca dahulu. Cuba ingat sebelum membuka jawapan.</p><section class="card"><div class="ar" lang="ar">${w[0]}</div>${reveal?`<p class="meaning">${w[1]}</p>`:'<p class="tiny" style="text-align:center">Tekan “Lihat Makna” untuk menyemak.</p>'}</section><div class="buttons">${!reveal?button('Lihat Makna','reveal=true;render()'):button(idx===cards.length-1?'Cuba Soalan':'Kad Seterusnya',idx===cards.length-1?"startQuiz('initial')":`openPart(${part},'flash',${idx+1})`)}${reveal?button('Ulang Kad Ini','reveal=false;render()','alt'):''}${button('Rehat Dahulu',"go('home')",'alt')}</div>`}
function rotate(a,n){return a.slice(n).concat(a.slice(0,n))}
function questions(n,reverse=false){const s=sections[n];let out=[];if(n<7){out=s[2].map((w,i)=>{const options=rotate(s[2].map(u=>reverse?u[0]:u[1]),i%s[2].length);return{id:'K'+i,w:i,p:reverse?`Pilih kalimah yang bermaksud “${w[1]}”.`:`Apakah makna ${w[0]}?`,o:options,a:options.indexOf(reverse?w[0]:w[1]),arabic:reverse}})}
const distract=[sections[(n+1)%9][1],sections[(n+2)%9][1]];const fo=rotate([s[1],...distract],n%3);out.push({id:'F',w:-1,p:'Pilih makna bagi frasa ini.',ar:s[0],o:fo,a:fo.indexOf(s[1])});out.push({id:'O',w:-1,p:t('Susun kalimah / unit mengikut urutan bacaan.','Tekan kalimah mengikut urutan bacaan.'),sort:true});return out}
function startQuiz(k){kind=k;quiz=questions(part,k!=='initial');if(k==='retry'){const needs=pstate().needs||[];quiz=quiz.filter(q=>needs.includes(q.id));if(!quiz.length)quiz=questions(part,true)}qi=0;answers=[];resetQ();delete profile().paused;save();go('quiz')}
function resetQ(){selected=null;checked=false;order=[]}
function choose(i){if(checked)return;const q=quiz[qi];if(q.sort){if(!order.includes(i))order.push(i)}else selected=i;render()}
function check(){const q=quiz[qi],len=sections[part][2].length;if(checked||q.sort&&order.length!==len||!q.sort&&selected===null)return;const ok=q.sort?order.every((v,i)=>v===i):selected===q.a;answers.push({id:q.id,w:q.w,ok});checked=true;render()}
function nextQ(){qi++;if(qi<quiz.length){resetQ();render();window.scrollTo(0,0)}else finishQuiz()}
function finishQuiz(){const s=pstate(),wrong=answers.filter(a=>!a.ok).map(a=>a.id);if(kind==='initial'&&!s.initial)s.initial=answers.slice();s.last=answers.slice();if(kind==='retry'){const attempted=answers.map(a=>a.id);s.needs=[...new Set([...(s.needs||[]).filter(id=>!attempted.includes(id)),...wrong])]}else s.needs=wrong;if(kind!=='initial'||s.attempted)s.practice=[...(s.practice||[]),...answers];s.attempted=true;delete profile().paused;profile().resume=part<8?{part:part+1,route:'learn',idx:0}:null;save();go('result')}
function pause(){profile().paused={part,quiz,qi,selected,checked,order,answers,kind};save();go('home')}
function continueQuiz(){const s=profile().paused;if(!s)return;({part,quiz,qi,selected,checked,order,answers,kind}=s);go('quiz')}
function quizView(){const q=quiz[qi],s=sections[part],units=s[2],ready=q.sort?order.length===units.length:selected!==null,last=answers[answers.length-1];return `<div class="ctx"><span>Bahagian ${part+1} · ${kind==='initial'?'Semakan':'Latihan Semula'}</span><span>${qi+1} / ${quiz.length}</span></div><h2>${esc(q.p)}</h2>${q.ar?`<div class="ar" lang="ar">${q.ar}</div>`:''}${q.sort?`<div class="stack">${units.map((_,i)=>`<button class="answer" ${checked?'disabled':''} onclick="order.splice(${i},1);render()"><span class="tiny">${i+1}.</span> <span lang="ar" dir="rtl" style="font-size:28px">${order[i]===undefined?'…':units[order[i]][0]}</span></button>`).join('')}</div><p class="tiny">Ruang 1 ialah permulaan bacaan. Tekan ruang untuk membuang pilihan.</p><div class="stack">${rotate(units.map((_,i)=>i),1).map(i=>`<button class="answer ar" lang="ar" ${checked||order.includes(i)?'disabled':''} onclick="choose(${i})">${units[i][0]}</button>`).join('')}</div>`:`<div class="stack">${q.o.map((v,i)=>`<button class="answer ${q.arabic?'ar':''} ${selected===i?'selected':''}" ${q.arabic?'lang="ar"':''} aria-pressed="${selected===i}" ${checked?'disabled':''} onclick="choose(${i})">${esc(v)}</button>`).join('')}</div>`}${checked?`<div class="feedback ${last.ok?'':'retry'}" role="status"><b>${last.ok?'Betul.':'Mari lihat semula.'}</b><p lang="ar" dir="rtl" style="font-size:28px">${q.w>=0?units[q.w][0]:s[0]}</p><p>${q.w>=0?units[q.w][1]:s[1]}</p></div>`:''}<div class="buttons">${checked?button(qi===quiz.length-1?'Lihat Keputusan':'Soalan Seterusnya','nextQ()'):`<button class="btn" ${ready?'':'disabled'} onclick="check()">Semak Jawapan</button>`}${button('Rehat Dahulu','pause()','alt')}</div>`}
function result(){const s=pstate(),a=s.initial||[],needs=s.needs||[];return `<div class="ey">BAHAGIAN ${part+1} · KEPUTUSAN</div><h2>${t('Semakan Bahagian '+(part+1),'Mari Lihat Kemajuan')}</h2><div class="pair"><div class="stat"><b>${a.filter(x=>x.ok).length} / ${a.length}</b><span class="tiny">Betul pada percubaan pertama</span></div><div class="stat"><b>${needs.length}</b><span class="tiny">Soalan untuk latihan lanjut</span></div></div><p class="sub">${needs.length?'Mari ulang bahagian ini supaya maknanya semakin jelas.':'Semakan selesai. Anda boleh meneruskan atau mengulang latihan.'}</p><p class="tiny">Semakan terkini: ${(s.last||[]).filter(x=>x.ok).length} / ${(s.last||[]).length} betul. Rekod percubaan pertama dikekalkan.</p><div class="buttons">${needs.length?button('Ulang Bahagian Ini',"startQuiz('retry')"):''}${button(part<8?'Teruskan ke Bahagian '+(part+2):'Baca Doa Lengkap',part<8?`openPart(${part+1})`:"go('full')")}${button('Ulang Kaji Saya',"go('review')",'alt')}${button('Menu Utama',"go('home')",'alt')}</div>`}
function full(){return `<div class="ey">DOA LENGKAP · SEMAKAN 03</div><h2>Bacaan dan Makna</h2><div class="stack">${['paired','arabic','meaning'].map((v,i)=>button(['Arab dan Makna','Arab Sahaja','Makna Lengkap'][i],`fullMode='${v}';render()`,fullMode===v?'':'alt')).join('')}</div>${fullMode==='meaning'?`<section class="card"><p class="sub" style="color:var(--ink)">${sections.map(s=>s[1]).join(' ')}</p></section>`:sections.map((s,n)=>`<section class="card"><p class="tiny">Bahagian ${n+1}</p><div class="ar" lang="ar">${s[0]}</div>${fullMode==='paired'?`<p class="meaning">${s[1]}</p>`:''}<button class="link" onclick="openPart(${n},'phrase')">Lihat pecahan bahagian ini</button></section>`).join('')}<p class="tiny">Riwayat al-Bukhari (6306), seperti dinyatakan dalam gambar rujukan asal. Pecahan ini untuk pembelajaran, bukan penetapan tempat waqaf.</p>${button('Semak Kefahaman Doa Lengkap',"startFinal('module')")}`}
function due(){return Number.isFinite(profile().dueAt)?profile().dueAt:null}
function startFinal(k){if(k==='retention'&&(!due()||Date.now()<due()))return;kind=k;finalIndex=0;finalAnswers=[];selected=null;checked=false;go('final')}
function finalOptions(n){return rotate([sections[n][1],sections[(n+1)%9][1],sections[(n+2)%9][1]],n%3)}
function finalCheck(){if(selected===null||checked)return;const options=finalOptions(finalIndex);finalAnswers.push({part:finalIndex,ok:options[selected]===sections[finalIndex][1]});checked=true;render()}
function finalNext(){if(finalIndex<8){finalIndex++;selected=null;checked=false;render();window.scrollTo(0,0)}else{if(kind==='module'){profile().moduleLast=finalAnswers;profile().moduleInitial=profile().moduleInitial||finalAnswers;profile().dueAt=profile().dueAt||Date.now()+DAY}else{profile().retentionLast=finalAnswers;profile().retentionAt=Date.now()}save();go('finalResult')}}
function finalView(){const options=finalOptions(finalIndex),last=finalAnswers[finalAnswers.length-1];return `<div class="ctx"><span>${kind==='retention'?'Semakan Ingatan 24 Jam':'Semakan Doa Lengkap'}</span><span>${finalIndex+1} / 9</span></div><h2>Apakah makna frasa ini?</h2><div class="ar" lang="ar">${sections[finalIndex][0]}</div><div class="stack">${options.map((v,i)=>`<button class="answer ${selected===i?'selected':''}" ${checked?'disabled':''} onclick="selected=${i};render()">${v}</button>`).join('')}</div>${checked?`<div class="feedback ${last.ok?'':'retry'}" role="status">${last.ok?'Betul.':'Mari lihat semula.'}<p>${sections[finalIndex][1]}</p></div>`:''}<div class="buttons">${checked?button(finalIndex===8?'Lihat Keputusan':'Seterusnya','finalNext()'):`<button class="btn" ${selected===null?'disabled':''} onclick="finalCheck()">Semak Jawapan</button>`}${button('Rehat Dahulu','pauseFinal()','alt')}</div>`}
function pauseFinal(){profile().pausedFinal={kind,finalIndex,finalAnswers,selected,checked};save();go('home')}
function continueFinal(){const f=profile().pausedFinal;if(!f)return;({kind,finalIndex,finalAnswers,selected,checked}=f);delete profile().pausedFinal;save();go('final')}
function finalResult(){delete profile().pausedFinal;save();return `<h2>Keputusan ${kind==='retention'?'Semakan Ingatan':'Doa Lengkap'}</h2><div class="stat"><b>${finalAnswers.filter(a=>a.ok).length} / 9</b><span>Frasa dijawab dengan betul</span></div><p class="sub">${kind==='retention'?'Semakan ingatan selesai. Ulang frasa yang masih memerlukan latihan.':'Semakan ingatan akan tersedia selepas 24 jam. Ulang kaji biasa boleh dilakukan pada bila-bila masa.'}</p>${finalAnswers.filter(a=>!a.ok).map(a=>navItem('Ulang Bahagian '+(a.part+1),sections[a.part][1],`openPart(${a.part},'flash')`)).join('')}${button('Ulang Kaji Saya',"go('review')")}`}
function review(){const d=due(),ready=d&&Date.now()>=d;const when=d?new Intl.DateTimeFormat('ms-MY',{dateStyle:'medium',timeStyle:'short',timeZone:'Asia/Kuala_Lumpur'}).format(new Date(d)):'';return `<h2>${t('Ulang Kaji Saya','Jom Ulang')}</h2><div class="stack">${sections.map((s,n)=>{const p=pstate(n);return navItem('Bahagian '+(n+1),p.initial?(p.needs?.length?`${p.needs.length} soalan untuk latihan semula`:'Telah disemak · boleh ulang lagi'):'Belum disemak',`part=${n};${p.needs?.length?"startQuiz('retry')":`openPart(${n},'flash')`}`)}).join('')}</div><section class="card"><h2>Semakan Ingatan 24 Jam</h2><p class="sub" style="margin:14px 0">${!d?'Selesaikan semakan doa lengkap untuk memulakan tempoh 24 jam.':profile().retentionAt?'Semakan ingatan telah dibuat. Anda boleh mencubanya semula.':ready?'Semakan ingatan sudah tersedia.':`Tersedia pada ${when} (waktu Malaysia).`}</p>${!d?button('Semak Doa Lengkap',"startFinal('module')"):ready?button('Mula Semakan Ingatan',"startFinal('retention')"):'<button class="btn" disabled>Belum Tiba Waktunya</button>'}</section><p class="tiny">Keputusan latihan menunjukkan kefahaman dan ingatan dalam aktiviti ini, bukan penilaian keadaan hati.</p>`}
function reflect(){return `<h2>Hayati Doa</h2><p class="sub">Renungan pembelajaran berikut dipaparkan berasingan daripada makna induk.</p>${['Mengakui Allah sebagai Rabb dan hanya Dia berhak disembah.','Mengingati bahawa Allah menciptakan kita dan kita ialah hambaNya.','Berusaha menunaikan tanggungjawab sesuai dengan kemampuan.','Memohon perlindungan daripada keburukan perbuatan sendiri.','Mengakui nikmat Allah, mengakui dosa dan memohon keampunanNya.'].map(x=>`<section class="card"><p class="sub">${x}</p></section>`).join('')}${button('Baca Doa dan Makna',"go('full')")}`}
function render(){const views={home,parts:partsView,flashParts:partsView,assessParts:partsView,learn:learning,phrase:phraseView,flash:flashView,quiz:quizView,result,full,final:finalView,finalResult,review,reflect};document.getElementById('app').className='app '+(kid()?'kid':'');document.getElementById('app').innerHTML=`<div class="screen"><header class="top"><div><div class="brand">AKSI</div><div class="tiny">Penghulu Isytighfar · ${kid()?'Kanak-kanak':'Dewasa'}</div></div>${route==='home'?'<span class="badge">Prototaip 16</span>':'<button class="pill" onclick="go(\'home\')">⌂ Menu</button>'}</header>${!storageOK?'<div class="notice" role="status">Kemajuan tidak dapat disimpan dalam pelayar ini.</div>':''}${route==='home'&&profile().paused?button('Sambung Soalan yang Dijeda','continueQuiz()','alt'):''}${route==='home'&&profile().pausedFinal?button('Sambung Semakan Doa Lengkap','continueFinal()','alt'):''}${(views[route]||home)()}<footer class="foot">AKSI · Sembilan Bahagian<br>Gaya berasaskan R09 · Kandungan Induk Semakan 03</footer></div>`}
save();render();
