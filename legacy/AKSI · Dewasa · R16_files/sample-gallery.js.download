(()=>{
const baseRender=render;
function gallery(){return `<header class="top"><div><div class="brand">AKSI</div><div class="tiny">Galeri 18 Visual · Versi 12</div></div><button class="pill" onclick="go('home')">⌂ Menu</button></header><div class="ey">SEMBILAN BAHAGIAN · DEWASA DAN KANAK-KANAK</div><h1>Visual Mengikut Makna</h1><p class="sub">Kesemua sembilan bahagian untuk dewasa serta kanak-kanak. Visual ialah gambaran penghayatan manusia terhadap doa.</p>${[0,1,2,3,4,5,6,7,8].map(n=>`<section class="card"><h2>Bahagian ${n+1}</h2><p class="meaning">${sections[n][1]}</p>${['adult','child'].map(m=>`<h3 style="margin:20px 0 10px">${m==='adult'?'Dewasa':'Kanak-kanak'}</h3><figure class="m01-visual"><img src="${M01_ASSETS[m+'-b'+String(n+1).padStart(2,'0')]}" alt="Contoh visual Bahagian ${n+1} ${m==='adult'?'dewasa':'kanak-kanak'}"></figure><button class="btn alt" style="margin-top:12px" onclick="db.mode='${m}';save();openPart(${n},'phrase')">Cuba dalam Skrin Frasa</button>`).join('')}</section>`).join('')}<div class="buttons">${button('Kembali ke Menu Utama',"go('home')",'alt')}</div><p class="foot">AKSI · Galeri 18 visual · Prototaip 16</p>`}
render=function(){if(route==='visualSamples'){window.askStopAudio?.();const app=document.getElementById('app');app.className='app';app.innerHTML='<div class="screen">'+gallery()+'</div>';return}baseRender();if(route==='home'){const menu=document.querySelector('#app .menu');if(menu){const box=document.createElement('div');box.innerHTML=navItem('Galeri Visual Sembilan Bahagian','18 visual · Dewasa dan kanak-kanak',"go('visualSamples')");menu.prepend(box)}}};render();
})();
