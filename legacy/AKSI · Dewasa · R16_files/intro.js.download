/* M01 screens 1 and 2, adapted to the approved Sayyidul Isytighfar content. */
(()=>{
const parentRender=render;
const scope=['Mengenali Sayyidul Isytighfar dan maknanya','Mempelajari 28 kalimah atau unit makna dalam konteks doa','Memahami sembilan frasa mengikut Jadual Kandungan Induk','Menggabungkan frasa menjadi doa lengkap','Mendengar bacaan Arab','Mengingat semula melalui kad imbas','Menyemak kefahaman kalimah dan frasa','Mengukuhkan bahagian yang memerlukan latihan','Menyemak ingatan selepas 24 jam','Menghayati makna doa','Kepentingan dan Kelebihan Sayyidul Isytighfar','Sumber Rujukan'];
const art=(key,alt)=>`<figure class="m01-visual"><img src="${M01_ASSETS[key]}" alt="${alt}" decoding="async"></figure>`;
const switcher=()=>`<div class="switch"><button class="${!kid()?'active':''}" aria-pressed="${!kid()}" onclick="db.mode='adult';save();go('${route}')">Dewasa</button><button class="${kid()?'active':''}" aria-pressed="${kid()}" onclick="db.mode='child';save();go('${route}')">Kanak-kanak</button></div>`;
const head=()=>`<header class="top"><div><div class="brand">AKSI</div><div class="tiny">Sayyidul Isytighfar · ${kid()?'Kanak-kanak':'Dewasa'}</div></div><button class="pill" onclick="go('home')">⌂ Menu</button></header>`;
function guide(){return `<details class="intro-guide"><summary>Panduan &amp; Bantuan</summary><div class="stack"><p class="sub">${t('Belajar mengikut kemampuan sendiri. Ulang bahagian yang masih belum jelas.','Belajar sedikit demi sedikit bersama ibu bapa atau guru. Tidak perlu tergesa-gesa.')}</p><ol class="intro-list"><li>Tekan <b>Mulakan Sayyidul Isytighfar</b>, kemudian <b>${t('Mula Belajar','Jom Belajar')}</b>.</li><li>Kenali kalimah atau unit makna, fahami frasa dan gunakan <b>Dengar</b>.</li><li>Cuba kad imbas dan semak kefahaman. Jika tersalah, lihat semula bantuan dan cuba lagi.</li><li>Selepas semakan doa lengkap, kembali selepas 24 jam untuk semakan ingatan.</li></ol><p class="tiny">Gunakan pelayar dan peranti yang sama untuk menyambung kemajuan. Buka dalam Chrome pada Android atau Safari pada iPhone jika audio senyap; semak kelantangan media.</p><p class="tiny"><b>Bantuan</b><br>WhatsApp: <a href="https://wa.me/60194459565" target="_blank" rel="noopener noreferrer">0194459565</a><br>E-mel: <a href="mailto:aicerdasglobal@gmail.com">aicerdasglobal@gmail.com</a></p></div></details>`}
function welcome(){return `${head()}${switcher()}<figure class="m01-visual m01-identity"><img src="${M01_ASSETS.identity}" alt="Pengasas dan identiti ACG, AKSI dan ATS" decoding="async"></figure><section class="hero intro-brand"><div class="ey">AKSI</div><h1>Aplikasi Sayyidul Isytighfar</h1><p class="sub">Belajar • Faham • Ingat • Amalkan</p><span class="intro-profile">${kid()?'Untuk kanak-kanak · Bersama ibu bapa atau guru':'Untuk dewasa'}</span></section>${guide()}<section class="card"><h2>Mengenali Sayyidul Isytighfar</h2><p class="sub">AKSI membantu anda mengenali bacaan Sayyidul Isytighfar, memahami maknanya dan mengukuhkan ingatan secara berperingkat.</p><details><summary>Lihat skop pembelajaran AKSI</summary><ol class="intro-list">${scope.map(x=>`<li>${x}</li>`).join('')}</ol></details><p class="tiny">Prototaip AKSI menyediakan sembilan bahagian pembelajaran Sayyidul Isytighfar, doa lengkap, latihan kefahaman dan ulang kaji.</p></section>${art(kid()?'child-home':'adult-s01',kid()?'Visual pembukaan kanak-kanak M01':'Visual pembukaan dewasa M01')}<section class="card"><div class="ey">KENALI DOA INI</div><h2>Sayyidul Isytighfar</h2><p class="sub">Penghulu Isytighfar</p><div class="ar" lang="ar">${sections[0][0]}</div><h3>Objektif Pembelajaran</h3><p class="sub">${t('Mengenal dan memahami makna Sayyidul Isytighfar, kemudian mengukuhkan ingatan melalui kalimah, frasa, kad imbas, latihan dan semakan berperingkat.','Mari kenali bacaan dan makna Sayyidul Isytighfar. Belajar sedikit demi sedikit, cuba ingat, jawab dan semak semula.')}</p></section><div class="buttons">${button('Mulakan Sayyidul Isytighfar',"go('journey')",'gold')}${button('Terus ke Menu Utama',"go('home')",'alt')}</div>`}
function journey(){const n=sections.reduce((sum,s)=>sum+s[2].length,0),completed=sections.filter((_,i)=>pstate(i).initial).length;return `${head()}${art(kid()?'child-home':'adult-s02',kid()?'Perjalanan belajar kanak-kanak M01':'Perjalanan belajar dewasa M01')}<div class="ey">PERJALANAN PEMBELAJARAN</div><h1>${t('Belajar secara berperingkat','Jom belajar sedikit demi sedikit')}</h1><p class="sub">${t('Kenali kalimah atau unit makna dalam setiap bahagian, gabungkan menjadi frasa, kemudian baca dan fahami doa lengkap.','Kenali kalimah, fahami frasa, kemudian gabungkan menjadi doa lengkap. Kita belajar satu bahagian dahulu, kemudian sambung bahagian seterusnya.')}</p><div class="intro-stages"><section><b>Tahap 1</b><strong>${n}</strong><span>Kalimah / unit makna</span></section><section><b>Tahap 2</b><strong>9</strong><span>Frasa</span></section><section><b>Tahap 3</b><strong>1</strong><span>Doa lengkap</span></section></div><section class="card sage"><b>Belajar → Ingat → Semak Kefahaman → Kukuhkan → Semak Ingatan</b><p class="sub">Kalimah → Frasa → Kad Imbas → Soalan → Ulang Kaji</p></section><section class="card"><h2>${t('Perjalanan sembilan bahagian','Sembilan langkah pembelajaran')}</h2><p class="sub">${completed} / 9 bahagian telah disemak.</p><ol class="intro-list">${sections.map((s,i)=>`<li><b>Bahagian ${i+1}</b> — ${s[1]}</li>`).join('')}</ol></section><section class="card"><h2>Semakan Ingatan 24 Jam</h2><p class="sub">Selesaikan semakan doa lengkap untuk memulakan tempoh 24 jam. Ulang kaji biasa boleh dibuat pada bila-bila masa.</p><p class="tiny">Keputusan menunjukkan aktiviti kefahaman dan ingatan, bukan penilaian keadaan hati atau bacaan lisan.</p></section>${guide()}<div class="buttons">${button(profile().resume?'Sambung Belajar':t('Mula Belajar','Jom Belajar'),'resume()')}${button('Pilih Bahagian',"go('parts')",'alt')}${button('Kembali ke Pengenalan',"go('welcome')",'alt')}${button('Menu Utama',"go('home')",'alt')}</div>`}
render=function(){if(route==='welcome'||route==='journey'){window.askStopAudio?.();const app=document.getElementById('app');app.className='app '+(kid()?'kid':'');app.innerHTML=`<div class="screen">${route==='welcome'?welcome():journey()}<footer class="foot">AKSI · Sayyidul Isytighfar · Prototaip 16<br>Kandungan Induk Semakan 03</footer></div>`;window.askMountAudio?.();return}parentRender();if(route==='home'){const screen=document.querySelector('#app .screen');const nav=document.createElement('div');nav.className='intro-links';nav.innerHTML=button('Pengenalan AKSI',"go('welcome')",'alt')+button('Perjalanan Pembelajaran',"go('journey')",'alt');screen?.querySelector('.switch')?.insertAdjacentElement('afterend',nav)}};
go('welcome');
})();
