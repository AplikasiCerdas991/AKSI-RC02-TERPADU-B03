/* Learning status uses observed cards and saved assessment evidence separately. */
function aksiJourneyProgress(){
const p=profile(),learned=[],trained=[],verified=[];let units=0;
for(let n=0;n<9;n++){const s=pstate(n),total=sections[n][2].length,seen=Array.isArray(s.learning?.units)?s.learning.units.filter(i=>Number.isInteger(i)&&i>=0&&i<total):[];units+=new Set(seen).size;if(new Set(seen).size===total&&s.learning?.phrase===true)learned.push(n);if(Array.isArray(s.initial)&&s.initial.length===questions(n).length&&Array.isArray(s.needs)&&s.needs.length===0)trained.push(n)}
const validDelay=Number.isFinite(p.dueAt)&&Number.isFinite(p.retentionAt)&&p.retentionAt>=p.dueAt;
if(validDelay&&Array.isArray(p.retentionLast))for(let n=0;n<9;n++)if(p.retentionLast.find(a=>a.part===n)?.ok===true)verified.push(n);
const modulePassed=Array.isArray(p.moduleLast)&&p.moduleLast.length===9&&new Set(p.moduleLast.map(a=>a.part)).size===9&&p.moduleLast.every(a=>a.ok===true);
return{learned,trained,verified,units,modulePassed,badges:[learned.length===9&&p.fullReadingSeen===true,trained.length===9&&modulePassed,validDelay&&verified.length===9&&p.retentionLast.length===9]};
}
function aksiJourneyNext(){
const p=profile(),s=aksiJourneyProgress();
if(p.pausedFinal)return{label:'Sambung Semakan Doa Lengkap',reason:'Sambung semakan yang dijeda.',action:'continueFinal()'};
if(p.paused)return{label:'Sambung Soalan yang Dijeda',reason:'Sambung soalan pada bahagian terakhir.',action:'continueQuiz()'};
const weak=sections.findIndex((_,n)=>pstate(n).needs?.length>0);if(weak>=0)return{label:'Kukuhkan Bahagian '+(weak+1),reason:'Ulang bahagian yang masih memerlukan latihan, kemudian cuba semula.',action:`part=${weak};startQuiz('retry')`};
if(p.resume&&s.learned.length<9)return{label:t('Sambung Belajar','Jom Sambung'),reason:t('Sambung pada bahagian terakhir mengikut kemampuan anda.','Sambung satu langkah demi satu langkah. Tidak perlu tergesa-gesa.'),action:'resume()'};
if(s.learned.length<9){const n=sections.findIndex((_,i)=>!s.learned.includes(i));return{label:s.learned.length||s.units?'Sambung Bahagian '+(n+1):t('Mula Belajar','Jom Belajar'),reason:'Kenali kalimah dan frasa Bahagian '+(n+1)+'.',action:`openPart(${n})`}}
if(!p.fullReadingSeen)return{label:'Baca Doa Lengkap',reason:'Gabungkan sembilan frasa dan fahami makna doa lengkap.',action:"go('full')"};
if(s.trained.length<9){const n=sections.findIndex((_,i)=>!s.trained.includes(i));return{label:'Semak Bahagian '+(n+1),reason:'Lengkapkan latihan kefahaman bahagian ini.',action:`part=${n};startQuiz('initial')`}}
if(!s.modulePassed)return{label:'Semak Doa Lengkap',reason:'Lengkapkan padanan makna kesemua sembilan frasa.',action:"startFinal('module')"};
if(!Number.isFinite(p.dueAt)||Date.now()<p.dueAt)return{label:'Lihat Waktu Semakan',reason:'Semakan ingatan tersedia selepas tempoh 24 jam. Ulang kaji biasa sentiasa boleh dibuat.',action:"go('review')"};
if(!s.badges[2])return{label:'Semak Ingatan',reason:'Semakan ingatan sudah tersedia. Cuba ingat semula makna frasa.',action:"startFinal('retention')"};
return{label:'Ulang Kaji Saya',reason:'Semakan makna selesai. Teruskan mengukuhkan bacaan dan maknanya.',action:"go('review')"};
}
function aksiJourneyToggle(){profile().journeyExpanded=profile().journeyExpanded===false;save();render()}
function aksiJourneyScreen(){
const p=profile(),s=aksiJourneyProgress(),next=aksiJourneyNext(),expanded=p.journeyExpanded!==false;
const names=['Selesai belajar','Selesai latihan','Lulus semakan makna'];
const tips=['Melalui kalimah dan frasa semua sembilan bahagian, serta paparan doa lengkap.','Melengkapkan latihan sembilan bahagian dan menjawab semakan doa lengkap dengan betul.','Menjawab semua sembilan frasa dengan betul dalam semakan ingatan selepas tempoh 24 jam. Bukan penilaian bacaan lisan.'];
const date=Number.isFinite(p.dueAt)?new Intl.DateTimeFormat('ms-MY',{dateStyle:'medium',timeStyle:'short',timeZone:'Asia/Kuala_Lumpur'}).format(new Date(p.dueAt)):null;
const historic=sections.some((_,n)=>pstate(n).initial&&!pstate(n).learning);
return `<header class="top"><div><div class="brand">AKSI</div><div class="tiny">Perjalanan Pembelajaran · ${kid()?'Kanak-kanak':'Dewasa'}</div></div><button class="pill" onclick="go('home')">⌂ Menu</button></header><figure class="m01-visual"><img src="${M01_ASSETS[kid()?'child-home':'adult-s02']}" alt="Perjalanan pembelajaran ${kid()?'kanak-kanak':'dewasa'}"></figure><div class="ey">PERJALANAN PEMBELAJARAN</div><h1>${t('Belajar secara berperingkat','Jom belajar sedikit demi sedikit')}</h1><p class="sub">Kenali kalimah atau unit makna, gabungkan kepada sembilan frasa, kemudian satukan sebagai doa lengkap.</p><div class="intro-stages"><section class="${s.units<28?'journey-active':''}"><b>Tahap 1</b><strong>28</strong><span>Kalimah / unit makna</span></section><section class="${s.units===28&&s.learned.length<9?'journey-active':''}"><b>Tahap 2</b><strong>9</strong><span>Frasa</span></section><section class="${s.learned.length===9?'journey-active':''}"><b>Tahap 3</b><strong>1</strong><span>Doa lengkap</span></section></div><section class="card sage"><b>Belajar → Ingat → Semak Kefahaman → Kukuhkan → Semak Ingatan</b></section>${button(next.label,next.action)}<section class="card journey-panel"><div class="ey">${t('KEMAJUAN ANDA','LANGKAH KECIL, TERUS MAJU')}</div><h2>Perjalanan Sembilan Bahagian</h2><p class="sub">${s.learned.length}/9 dipelajari · ${s.trained.length}/9 selesai latihan · ${s.verified.length}/9 disemak selepas tempoh menunggu</p><button class="btn alt" aria-expanded="${expanded}" aria-controls="journeyDetails" onclick="aksiJourneyToggle()">${expanded?'Ringkaskan paparan':'Lihat peta dan pencapaian'}</button><div id="journeyDetails" ${expanded?'':'hidden'}><h3>Peta Pembelajaran</h3><div class="journey-map">${sections.map((_,n)=>{const l=s.learned.includes(n),tr=s.trained.includes(n),v=s.verified.includes(n);return `<button class="journey-stop ${l?'done':''}" onclick="openPart(${n})"><span aria-hidden="true">${l?'✓':n+1}</span><b>Bahagian ${n+1}</b><small>${l?'Telah dipelajari':pstate(n).learning?'Sedang dipelajari':'Belum direkodkan'}</small><small>${tr?'Latihan selesai':pstate(n).needs?.length?'Perlu pengukuhan':'Latihan belum selesai'}</small>${v?'<small>✓ Semakan ingatan betul</small>':''}</button>`}).join('')}</div><h3>Pencapaian Pembelajaran</h3><div class="stack">${names.map((name,i)=>`<div class="journey-badge ${s.badges[i]?'earned':''}"><span aria-hidden="true">${s.badges[i]?'✓':'○'}</span><div><b>${name}</b><p>${tips[i]}</p><strong>${s.badges[i]?'Dicapai':'Belum dicapai'}</strong></div></div>`).join('')}</div>${historic?'<p class="tiny">Rekod latihan terdahulu dikekalkan. Rekod melalui kad pembelajaran bermula Versi 12; bahagian lama tidak ditandakan dipelajari secara automatik.</p>':''}</div><section class="journey-next"><h3>Langkah Seterusnya</h3><p class="sub">${next.reason}</p>${button(next.label,next.action)}</section><p class="tiny">Penanda ini menunjukkan aktiviti pembelajaran, bukan penilaian keadaan hati.</p></section><section class="card"><h2>Waktu Semakan Ingatan</h2><p class="sub">${date?`Tersedia pada ${date} (waktu Malaysia). ${Date.now()>=p.dueAt?'Semakan sudah tersedia.':'Belum tiba waktunya.'}`:'Waktu akan dipaparkan selepas semakan doa lengkap selesai.'}</p><p class="tiny">Status dikemas kini apabila skrin dibuka semula. Kemajuan disimpan pada pelayar dan peranti yang sama.</p>${button('Lihat Ulang Kaji Saya',"go('review')",'alt')}</section><div class="buttons">${button('Pilih Bahagian',"go('parts')",'alt')}${button('Panduan & Bantuan','aksiHelp()','alt')}${button('Kembali ke Pengenalan',"go('welcome')",'alt')}${button('Menu Utama',"go('home')",'alt')}</div><footer class="foot">AKSI · Sayyidul Isytighfar · Prototaip 16</footer>`;
}
(()=>{
const baseRender=render;
render=function(){
if(route==='learn'||route==='phrase'){const s=pstate();s.learning=s.learning||{units:[],phrase:false};if(route==='learn'){const i=Math.max(0,Math.min(idx,sections[part][2].length-1));if(!s.learning.units.includes(i))s.learning.units.push(i)}else s.learning.phrase=true;save()}
if(route==='full'&&!profile().fullReadingSeen){profile().fullReadingSeen=true;save()}
if(route==='journey'){window.askStopAudio?.();const app=document.getElementById('app');app.className='app '+(kid()?'kid':'');app.innerHTML='<div class="screen">'+aksiJourneyScreen()+'</div>';return}
baseRender();
};render();
})();
