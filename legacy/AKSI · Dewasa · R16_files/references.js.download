/* Sources: supplied JAKIM infographic, Quran 4:110, Sahih al-Bukhari 6306. */
(()=>{
const suppliedInfographics=[{"title":"Istighfar Selepas Solat","note":"Riwayat Muslim 591, seperti tercatat pada infografik.","src":"data:image/png;base64,"},{"title":"Penghulu Istighfar — latar biru","note":"Riwayat al-Bukhari 6306, seperti tercatat pada infografik.","src":"data:image/png;base64,"},{"title":"Solat Taubat dan Penghulu Istighfar","note":"Sumber: Ensiklopedia Solat, seperti tercatat pada infografik.","src":"data:image/png;base64,"},{"title":"Memperbanyakkan Istighfar","note":"Riwayat Abu Daud 1518 dan Ibn Majah 3819, seperti tercatat pada infografik.","src":"data:image/png;base64,"}];
let selectedInfographic=-1;
window.aksiOpenReference=function(i){selectedInfographic=i;go('infographic')};
const baseRender=render;
const link=(url,label)=>`<a class="ref-link" href="${url}" target="_blank" rel="noopener noreferrer">${label} ↗</a>`;
const header=()=>`<header class="top"><div><div class="brand">AKSI</div><div class="tiny">Sayyidul Isytighfar · ${kid()?'Kanak-kanak':'Dewasa'}</div></div><button class="pill" onclick="go('home')">⌂ Menu</button></header>`;
function merits(){return `${header()}<div class="ey">SKOP PEMBELAJARAN · 11</div><h1>Kepentingan dan Kelebihan Sayyidul Isytighfar</h1><p class="sub">${t('Kenali dalil dan hayati maksudnya.','Jom kenali sebab kita memohon keampunan Allah, bersama ibu bapa atau guru.')}</p><section class="card"><span class="badge">Al-Quran · Dalil umum istighfar</span><h2>Allah Maha Pengampun</h2><p class="sub">${t('Surah an-Nisa’ 4:110 menerangkan bahawa orang yang melakukan keburukan atau menzalimi dirinya, kemudian memohon keampunan Allah, akan mendapati Allah Maha Pengampun lagi Maha Mengasihani.','Apabila kita melakukan kesalahan, mohonlah keampunan Allah. Surah an-Nisa’ 4:110 mengingatkan bahawa Allah Maha Pengampun lagi Maha Mengasihani.')}</p><p class="tiny">Ringkasan maksud ayat. Ayat ini menerangkan kepentingan istighfar secara umum.</p>${link('https://quran.com/4/110','Baca Surah an-Nisa’ 4:110')}</section><section class="card"><span class="badge">Hadis sahih · Dalil khusus</span><h2>Penghulu Istighfar</h2><p class="sub">${t('Dalam hadis yang diriwayatkan oleh Shaddad bin Aus RA, Nabi Muhammad SAW mengajarkan doa ini sebagai Sayyidul Istighfar.','Nabi Muhammad SAW mengajarkan doa Sayyidul Istighfar kepada kita. Hadis ini diriwayatkan oleh Shaddad bin Aus RA.')}</p><p class="tiny">Rujukan: Sahih al-Bukhari, hadis 6306.</p>${link('https://sunnah.com/bukhari:6306','Baca hadis sahih 6306')}</section><section class="card sage"><h2>Kelebihan yang Disebut dalam Hadis</h2><p class="sub">${t('Hadis tersebut menyebut bahawa orang yang membacanya pada siang hari dengan penuh keyakinan terhadapnya, kemudian meninggal dunia pada hari itu sebelum petang, termasuk dalam kalangan penghuni syurga. Begitu juga orang yang membacanya pada malam hari dengan penuh keyakinan terhadapnya, kemudian meninggal dunia sebelum pagi.','Hadis ini menyebut kelebihan yang besar: orang yang membaca doa ini pada siang hari dengan penuh keyakinan, lalu meninggal dunia sebelum petang, termasuk dalam kalangan penghuni syurga. Begitu juga jika membacanya pada malam hari dengan penuh keyakinan, lalu meninggal dunia sebelum pagi.')}</p><p class="tiny"><b>Ringkasan maksud hadis:</b> syarat penuh keyakinan serta keadaan siang dan malam diterangkan bersama kelebihannya.</p>${link('https://sunnah.com/bukhari:6306','Lihat sumber kelebihan ini')}</section><section class="card"><h2>${t('Hayati Kandungan Doa','Apa yang kita pelajari?')}</h2><ul class="intro-list"><li>Mengakui Allah sebagai Rabb dan hanya Dia berhak disembah.</li><li>Mengakui diri sebagai hamba Allah dan nikmatNya kepada kita.</li><li>Mengakui dosa sendiri, memohon perlindungan dan keampunan Allah.</li></ul><p class="tiny">Renungan pembelajaran berdasarkan kandungan doa; dipaparkan berasingan daripada makna induk.</p></section><div class="buttons">${button('Lihat Sumber Rujukan',"go('sources')")}${button('Baca Doa dan Makna',"go('full')",'alt')}${button('Menu Utama',"go('home')",'alt')}</div>`}
function sources(){return `${header()}<div class="ey">SKOP PEMBELAJARAN · 12</div><h1>Sumber Rujukan</h1><p class="sub">Rujukan teks doa, makna dan penerangan dalil dalam AKSI.</p><section class="card"><h2>Infografik JAKIM</h2><p class="sub">Rujukan teks Arab dan makna: Infografik Penghulu Istighfar, Jabatan Kemajuan Islam Malaysia (JAKIM), seperti dilampirkan.</p><figure class="reference-figure"><img src="${JAKIM_INFOGRAPHIC}" alt="Infografik Penghulu Istighfar JAKIM: teks Arab, makna Bahasa Malaysia dan rujukan al-Bukhari 6306" decoding="async"></figure>${button('Besarkan Gambar',"aksiOpenReference(-1)",'alt')}<p class="tiny">Infografik asal dipaparkan lengkap bersama logo dan atribusi JAKIM.</p></section>${suppliedInfographics.map((item,i)=>`<section class="card"><h2>${item.title}</h2><figure class="reference-figure"><img src="${item.src}" alt="Infografik JAKIM: ${item.title}" loading="lazy" decoding="async"></figure><p class="tiny">Jabatan Kemajuan Islam Malaysia — JAKIM. ${item.note}</p>${button("Besarkan Gambar", "aksiOpenReference("+i+")", "alt")}</section>`).join('')}<p class="tiny">Empat infografik tambahan dipaparkan sebagaimana dilampirkan. Terjemahan pada sesetengah infografik berbeza daripada makna induk AKSI. Rujukan riwayat di atas menyalin label asal infografik, bukan pengesahan taraf hadis.</p><section class="card"><h2>Al-Quran</h2><p class="sub"><b>Surah an-Nisa’ 4:110</b><br>Dalil umum tentang memohon keampunan Allah.</p>${link('https://quran.com/4/110','Buka ayat di Quran.com')}</section><section class="card"><h2>Hadis Sahih</h2><p class="sub"><b>Sahih al-Bukhari 6306</b><br>Riwayat Shaddad bin Aus RA: lafaz Sayyidul Istighfar dan kelebihan membacanya dengan penuh keyakinan pada siang atau malam.</p>${link('https://sunnah.com/bukhari:6306','Buka hadis di Sunnah.com')}</section><section class="notice"><b>Cara membaca sumber</b><br>Infografik JAKIM menjadi rujukan doa dan makna. Ayat al-Quran menerangkan istighfar secara umum; hadis sahih menjadi dalil khusus doa dan kelebihannya. Penerangan AKSI ialah ringkasan pembelajaran.</section><div class="buttons">${button('Kepentingan dan Kelebihan',"go('merits')")}${button('Menu Utama',"go('home')",'alt')}</div>`}
function infographic(){const item=selectedInfographic>=0?suppliedInfographics[selectedInfographic]:null;return `${header()}<h2>${item?item.title:'Infografik JAKIM'}</h2><p class="sub">Leret ke sisi dan ke bawah untuk membaca gambar yang dibesarkan.</p><div class="infographic-zoom" tabindex="0" role="region" aria-label="Gambar JAKIM dibesarkan; leret untuk membaca"><img src="${item?item.src:JAKIM_INFOGRAPHIC}" alt="Infografik asal JAKIM: Penghulu Istighfar" /></div>${button('Kembali ke Sumber Rujukan',"go('sources')")}<p class="tiny">Jabatan Kemajuan Islam Malaysia — JAKIM.</p>`}
render=function(){if(['merits','sources','infographic'].includes(route)){window.askStopAudio?.();const app=document.getElementById('app');app.className='app '+(kid()?'kid':'');app.innerHTML=`<div class="screen">${route==='merits'?merits():route==='sources'?sources():infographic()}<footer class="foot">AKSI · Aplikasi Sayyidul Isytighfar · Prototaip 16</footer></div>`;return}baseRender();if(route==='home'){const menu=document.querySelector('#app .menu');if(menu){const box=document.createElement('div');box.className='stack';box.innerHTML=navItem('Kepentingan dan Kelebihan','Dalil al-Quran dan hadis sahih',"go('merits')")+navItem('Sumber Rujukan','Infografik JAKIM dan pautan dalil',"go('sources')");menu.append(box)}}};render();
})();
